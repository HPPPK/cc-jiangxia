{
  "version": 1,
  "steps": [
    {
      "type": "form",
      "id": "research-brief",
      "title": "新品商业化调研信息",
      "required": true,
      "fields": [
        {
          "id": "productDirection",
          "kind": "text",
          "label": "产品方向名称",
          "description": "例如：AI 旧照片修复、AI 简历优化。",
          "required": true
        },
        {
          "id": "coreCapability",
          "kind": "textarea",
          "label": "核心能力的一句话描述",
          "description": "写清产品最核心的能力或卖点。",
          "required": true
        },
        {
          "id": "marketScope",
          "kind": "select",
          "label": "优先研究市场",
          "required": true,
          "options": [
            {
              "id": "china",
              "label": "中国 C 端工具市场（默认）"
            },
            {
              "id": "overseas",
              "label": "海外市场"
            },
            {
              "id": "both",
              "label": "中国与海外对比"
            }
          ]
        },
        {
          "id": "preferredPlatforms",
          "kind": "multi-select",
          "label": "优先评估的平台形态（可选）",
          "options": [
            {
              "id": "windows",
              "label": "Windows 客户端"
            },
            {
              "id": "macos",
              "label": "macOS 客户端"
            },
            {
              "id": "mobile",
              "label": "iOS / Android APP"
            },
            {
              "id": "web",
              "label": "Web 网页端"
            },
            {
              "id": "mini-program",
              "label": "微信小程序"
            }
          ]
        },
        {
          "id": "firstPartyMaterials",
          "kind": "file-list",
          "label": "一手资料（强烈建议）",
          "description": "可提供关键词 CSV、指数截图、应用商店截图、竞品定价截图、已有调研文档等。"
        },
        {
          "id": "referenceUrls",
          "kind": "url-list",
          "label": "参考链接（可选）",
          "description": "竞品官网、价格页、应用商店页、公开行业资料等。"
        },
        {
          "id": "constraints",
          "kind": "textarea",
          "label": "补充约束（可选）",
          "description": "例如目标价格、已有渠道资源、必须避开的产品方向或交付时间。"
        },
        {
          "id": "outputFolder",
          "kind": "folder",
          "label": "正式 HTML 输出目录",
          "description": "只在你确认报告结论后写入此目录。",
          "required": false
        }
      ]
    }
  ]
}
